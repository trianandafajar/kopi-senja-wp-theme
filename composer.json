{
  "name": "trianandafajar/kopi-senja",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "Kopi Senja — WordPress theme for a fictional Indonesian specialty coffee shop & roastery. Based on Sage by Roots.",
  "homepage": "https://github.com/trianandafajar",
  "authors": [
    {
      "name": "trianandafajar",
      "homepage": "https://github.com/trianandafajar",
      "role": "Developer"
    },
    {
      "name": "Roots",
      "homepage": "https://roots.io/sage/",
      "role": "Original Sage starter theme"
    }
  ],
  "keywords": [
    "wordpress",
    "wordpress-theme",
    "coffee",
    "sage",
    "blade",
    "tailwindcss"
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require": {
    "php": ">=8.3",
    "roots/acorn": "^6.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
