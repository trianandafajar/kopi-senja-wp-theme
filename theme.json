{
  "__preprocessed__": "This file is used to build the theme.json file in the `public/build/assets` directory. The built artifact includes Tailwind's colors, fonts, and font sizes.",
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "46rem",
      "wideSize": "72rem"
    },
    "background": {
      "backgroundImage": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": []
    },
    "custom": {
      "spacing": {},
      "typography": {
        "font-size": {},
        "line-height": {}
      }
    },
    "spacing": {
      "padding": true,
      "units": [
        "px",
        "%",
        "em",
        "rem",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream-50)",
      "text": "var(--wp--preset--color--espresso-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.15"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--terracotta-500)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "9999px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--terracotta-600)"
          }
        }
      }
    },
    "blocks": {
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--terracotta-400)",
          "style": "solid",
          "width": "0 0 0 3px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontStyle": "italic"
        }
      }
    }
  }
}
